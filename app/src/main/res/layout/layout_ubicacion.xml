<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cartel de Error GPS -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- Dirección en GRANDE -->
    <TextView
        android:id="@+id/tv_direccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Obteniendo dirección..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <!-- MapView de OpenStreetMap (OSMDroid) -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Campo de Referencia y Botón Firebase -->
    <EditText
        android:id="@+id/et_referencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese una referencia (ej: Esquina del hospital)"
        android:textColorHint="#AAAAAA"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btn_guardar_ubicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REGISTRAR UBICACIÓN"
        android:backgroundTint="#2850C6"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

</LinearLayout>